# ==============================================================================
# DataPulse Latam - Variables de Entorno (Plantilla)
# Copia este archivo como ".env" y reemplaza los valores de ejemplo.
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_DB=datapulse
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=cambia-esta-clave-postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# En Docker Compose el host es "db". Para desarrollo local sin Docker usa "localhost".
DATABASE_URL=postgres://datapulse:cambia-esta-clave-postgres@db:5432/datapulse

# --- Django ---
# Genera una clave segura con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esta-clave-secreta-de-django
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- CORS y CSRF ---
# En producción agrega las URLs públicas HTTPS de tu frontend (Vercel/Netlify) y backend (Render/Railway)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# --- JWT (SimpleJWT) ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1